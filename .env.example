# ==============================================================================
# RAG Memory Agent Configuration
# ==============================================================================

# LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Models:
# - Gemini default: gemini-2.5-flash
# - OpenAI default: gpt-4o-mini
LLM_MODEL=gemini-2.5-flash

# API Keys (Set whichever provider you are using)
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Server Binding (Default to localhost for security)
HOST=127.0.0.1
PORT=8000

# Persistence & Storage
PERSIST_DIR=./data/chroma
COLLECTION_NAME=assistant_memory

# Feature Flags & Safety
# NOTE: python_executor runs in a 5s subprocess with limited output.
# It is designed for demonstrations and is NOT a hardened security sandbox.
ENABLE_PYTHON_EXECUTOR=true

# Evaluation settings
# Pause in seconds between eval turns to avoid hitting free-tier rate limits
EVAL_PAUSE_SECONDS=1.0

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
